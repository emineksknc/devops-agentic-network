PROJECT_NAME="DevOps Agentic Network"

# GitHub Bilgileri
GITHUB_TOKEN=""

# GitHub Repo Sahibi ve Repo Adı
GITHUB_OWNER=""
GITHUB_REPO="devops-agentic-network"

# Jira Bilgileri
JIRA_API_TOKEN=""
JIRA_DOMAIN="https://{your_jira_domain}.atlassian.net/"
JIRA_USER_EMAIL=""

JIRA_PROJECT_KEY=""

# LLM Ayarları (provider: ollama | openai | anthropic | gemini)
LLM_PROVIDER="ollama"
LLM_MODEL="llama3.1:latest"
OLLAMA_HOST="http://localhost:11434"
# Cloud provider anahtari (openai/anthropic/gemini icin; baglanti token'i env'nin onune gecer)
LLM_API_KEY=""

# LangFuse (bos birakilirsa tracing no-op olur; musteriye gostermek zorunda degilsin)
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# Web API / SQLite
DAN_DB_PATH="data/dan.db"
